# منفذ الاستماع للخادم (تعيّنه منصات الاستضافة تلقائياً مثل Render و Railway)
PORT=3000
HOST=0.0.0.0

# قاعدة بيانات سحابية دائمة (PostgreSQL — مثل Neon أو Supabase أو Render PostgreSQL)
# مهم جداً على باقة Render المجانية: بدون DATABASE_URL تُمسح البيانات وحسابات المساعدين والصور عند سكون الموقع!
DATABASE_URL=

# مسار ملف قاعدة بيانات SQLite المحلية (يُتزامن تلقائياً مع السحابة عند وجود DATABASE_URL)
CP4_DB_PATH=./data/cp4_arena.db

# مجلد حفظ صور اللاعبين وأغلفة البطولات المرفوعة (وتُنسخ تلقائياً داخل قاعدة البيانات والـ PostgreSQL)
CP4_UPLOADS_DIR=./data/uploads

# مفتاح التوقيع المشفّر لرموز JWT (يبقي المشرف الرئيسي والمساعدين مسجلين تلقائياً حتى بعد إعادة تشغيل الخادم)
JWT_SECRET=replace-with-a-strong-random-64-char-jwt-secret
CP4_SESSION_SECRET=

# اختياري: كلمة سر بديلة (يُشتق منها توقيع JWT إذا لم يُحدد JWT_SECRET، وإذا كانت 6 أرقام تُهيّئ حساب المشرف الرئيسي أيضاً)
ADMIN_PASSWORD=

# اختياري: إنشاء حساب المشرف الرئيسي عند التشغيل الأول فقط (PIN من 6 أرقام)
CP4_HEAD_ADMIN_USERNAME=Djilali
CP4_HEAD_ADMIN_PIN=

# اختياري: مصفوفة JSON لتعريف حسابات المساعدين بشكل دائم في البيئة
# مثال: [{"username":"sub1","displayName":"مساعد النتائج","pin":"123456","canEditScores":true}]
CP4_SUB_ADMINS_JSON=

# ربط Discord لملفات اللاعبين الموحدة (OAuth التلقائي + قائمة أعضاء السيرفر + إشعارات البوت)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_CHANNEL_ID=
DISCORD_PUBLIC_CHANNEL_ID=
